{
  "expo": {
    "name": "ProjectVerse",
    "slug": "ProjectVerse",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/logo.png",

    "scheme": "projectverse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "icon": "./assets/images/logo.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.irfanmhdm.ProjectVerse"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7FB",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F5F7FB"
          }
        }
      ],

      "expo-video"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "3aa8782f-c702-4f05-9772-dcaa0210a5d9"
      }
    }
  }
}